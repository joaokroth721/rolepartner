{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "rolepartner",
  "compatibility_date": "2026-09-01",
  // The Worker runtime is workerd, not Node: Next and its deps need the Node compat layer.
  "compatibility_flags": ["nodejs_compat"],
  // Prerendered pages and /public are served as static assets (free and unmetered),
  // so only the /api routes spend the Worker request budget.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Favorites, conversation transcripts and the leaderboard. Create the database once with
  //   npx wrangler d1 create rolepartner
  // and paste the id it prints into "database_id" below, then apply the schema:
  //   npx wrangler d1 migrations apply rolepartner --remote
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rolepartner",
      "database_id": "PASTE_D1_DATABASE_ID_HERE"
    }
  ]
}
