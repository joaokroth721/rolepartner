# Uma chave só, pro "cérebro" que responde em alemão.
# Usada por /api/chat, /api/feedback e /api/translate (o model é openai(...), que lê OPENAI_API_KEY).
OPENAI_API_KEY=

# Login Google (Auth.js v5). Credenciais OAuth: https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Gere com: openssl rand -base64 33
AUTH_SECRET=

# PostHog (analytics de produto). Chave publicável: vai pro bundle do cliente de propósito.
# NEXT_PUBLIC_* é embutido no BUILD, então não pode ser secret do Worker: precisa estar
# presente quando `npm run deploy` roda (ex.: .env.production, commitado, ou o ambiente de CI).
# Região escolhida no cadastro e irreversível. Host: https://eu.i.posthog.com ou https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Quem abre /admin. Lista separada por vírgula, casada com o e-mail da conta Google.
# Só isto dá o primeiro acesso: a tabela `admins` começa vazia e a UI que a preenche já
# está atrás do mesmo portão. Quem está aqui não pode ser removido pela UI, então é
# também o caminho de volta se a lista for esvaziada por engano.
ADMIN_EMAILS=
