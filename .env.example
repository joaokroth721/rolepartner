# Uma chave só, pro "cérebro" que responde em alemão.
# Pega em https://vercel.com/ai-gateway (ou use OPENAI_API_KEY direto trocando o model no route.js)
AI_GATEWAY_API_KEY=

# Login Google (Auth.js v5). Credenciais OAuth: https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Gere com: openssl rand -base64 33
AUTH_SECRET=
